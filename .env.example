# ============================================================
# Copia este archivo a .env y completa los valores.
# .env NUNCA se sube a git (está en .gitignore).
# Las contraseñas usan ${VAR:?} en los compose: si falta una, Docker se detiene.
# ============================================================

DOMAIN=luispicado.com

# ------------------------------------------------------------
# Seguridad (Caddy: entrada HTTP y contraseña para servicios sin login)
# ------------------------------------------------------------
# Usuario común para los servicios que no tienen login propio.
CADDY_BASIC_USER=
# Hash bcrypt generado con: docker run --rm caddy:2.8 caddy hash-password --plaintext "TU_CLAVE"
# Va entre comillas simples porque contiene '$'.
CADDY_BASIC_PASSWORD_HASH=''

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
# Carpeta raíz de los datos de SFTP, MinIO y Apache. Debe existir.
# Cada quien la pone donde tenga espacio: C:/datos-lab, D:/datos-lab, F:, etc.
# Sin barra al final. Las subcarpetas (sftp, sftpgo-data, minio-data, apache-fileserver) se crean dentro.
DATA_ROOT=C:/datos-lab
SQLSERVER_SA_PASSWORD=
SQLSERVER_HOST_PORT=51430

DB2_INSTANCE_PASSWORD=
DB2_HOST_PORT=51431

SFTPGO_SFTP_HOST_PORT=51432

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=

# ------------------------------------------------------------
# Kafka con Zookeeper
# ------------------------------------------------------------
ZOO_KAFKA_HOST_PORT=51435
ZOO_POSTGRES_PASSWORD=

# ------------------------------------------------------------
# Kafka con KRaft
# ------------------------------------------------------------
KRAFT_CLUSTER_ID=q1Sh-7dTQk6o9x8JH2zYwA
KRAFT_KAFKA1_HOST_PORT=51437
KRAFT_KAFKA2_HOST_PORT=51438
KRAFT_KAFKA3_HOST_PORT=51439
KRAFT_POSTGRES_PASSWORD=

# ------------------------------------------------------------
# Databricks (Spark, Jupyter, MLflow, Vault)
# ------------------------------------------------------------
JUPYTER_TOKEN=
# Base de metadatos de Hive Metastore (Postgres, sin puerto publicado)
HIVE_POSTGRES_PASSWORD=

# ------------------------------------------------------------
# Orquestación (Airflow)
# ------------------------------------------------------------
AIRFLOW_POSTGRES_PASSWORD=
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# ------------------------------------------------------------
# Observabilidad (Grafana)
# ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ------------------------------------------------------------
# Herramientas (pgAdmin, Homepage)
# ------------------------------------------------------------
# Login de pgAdmin. Se usa para entrar a la interfaz web, no para los Postgres.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Login de FileBrowser (subida y descarga de archivos). Usa una clave fuerte.
FILEBROWSER_ADMIN_USER=admin
FILEBROWSER_ADMIN_PASSWORD=
